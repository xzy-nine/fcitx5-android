<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- remove unused permission from AppCompat -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- custom: 内置语音输入（录音采集 + 模型下载所需） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- remove intent queries merged from library manifest (namely Android-Image-Cropper) -->
    <queries tools:node="removeAll" />

    <queries>
        <intent>
            <action android:name="${applicationId}.plugin.VOICE_INPUT" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <intent>
            <action android:name="org.rime.plugin.MANIFEST" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
    </queries>

    <permission
        android:name="${applicationId}.permission.IPC"
        android:protectionLevel="signature" />

    <permission
        android:name="${applicationId}.permission.PLUGIN"
        android:protectionLevel="signature" />

    <permission
        android:name="org.fcitx.fcitx5.android.permission.CLIPBOARD_BROADCAST"
        android:protectionLevel="normal" />

    <uses-permission android:name="${applicationId}.permission.PLUGIN" />
    <uses-permission android:name="org.fcitx.fcitx5.android.permission.CLIPBOARD_BROADCAST" />

    <application
        android:name=".FcitxApplication"
        android:allowBackup="true"
        android:backupAgent=".data.UiSettingsBackupAgent"
        android:fullBackupOnly="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FcitxAppTheme"
        android:usesCleartextTraffic="true"
        tools:replace="android:supportsRtl"
        tools:targetApi="33">
        <activity
            android:name=".ui.main.settings.behavior.UserDataRestoreActivity"
            android:exported="false"
            android:process=":restore"
            android:theme="@style/Theme.FcitxSettings.System" />
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.FcitxSettings.System"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.main.wanxiang.WanxiangAdvancedActivity"
            android:exported="false"
            android:label="@string/wanxiang_advanced" />
        <activity
            android:name=".ui.main.settings.theme.CustomThemeActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="@string/edit_theme" />
        <activity
            android:name=".ui.main.settings.theme.ThemeColorEditorActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="@string/edit_color" />
        <activity
            android:name=".ui.main.settings.icon.IconThemeEditorActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="@string/edit_icon_theme" />
        <activity
            android:name=".ui.main.settings.behavior.PopupEditorActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/edit_popup_preset" />
        <activity
            android:name=".ui.main.settings.behavior.TextKeyboardLayoutEditorActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/edit_text_keyboard_layout" />
        <activity
            android:name=".ui.main.settings.behavior.dialog.KeyEditorActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/edit_text_keyboard_layout" />
        <activity
            android:name=".ui.main.settings.behavior.dialog.LayoutFileProfileInputActivity"
            android:exported="false"
            android:label="@string/edit_text_keyboard_layout" />
        <activity
            android:name=".ui.main.settings.behavior.dialog.LayoutNameInputActivity"
            android:exported="false"
            android:label="@string/edit_text_keyboard_layout" />
        <activity
            android:name=".ui.main.update.UpdateCheckActivity"
            android:exported="false"
            android:label="@string/update_page_title" />
        <!--
            Registered even though no entry point navigates here yet: the class, its adapter
            and its layout all exist, so an unregistered declaration is a latent
            ActivityNotFoundException the moment an entry point is added.
        -->
        <activity
            android:name=".ui.main.settings.behavior.share.QrScanCaptureActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name=".ui.main.settings.behavior.ButtonsCustomizerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/edit_buttons" />
        <activity
            android:name=".ui.main.CropImageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.SymbolSliderEditActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="org.fcitx.fcitx5.android.symbols"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />
        <!-- custom: 录音权限的透明中转 Activity（输入法服务无法自行发起运行时权限请求） -->
        <activity
            android:name=".ui.main.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".input.FcitxInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="${appLabel}"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <service
            android:name=".core.engine.RimeEngineProbeService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":rime_engine_probe"
            android:stopWithTask="true" />

        <service
            android:name=".FcitxRemoteService"
            android:permission="${applicationId}.permission.IPC"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.IPC" />
            </intent-filter>
        </service>

        <service
            android:name=".BroadcastPairingService"
            android:exported="true"
            android:permission="org.fcitx.fcitx5.android.permission.CLIPBOARD_BROADCAST">
            <intent-filter>
                <action android:name="org.fcitx.fcitx5.android.BROADCAST_PAIRING" />
            </intent-filter>
        </service>

        <!--
          custom: 离线语音识别服务（官方 sherpa-onnx 引擎）。
          独立 `:asr` 进程：模型加载与 dlopen sherpa/ONNX Runtime 不占用输入法进程内存；
          该进程不初始化 AppPrefs/剪贴板/WebDAV 子系统（见 FcitxApplication 的进程守卫），
          模型文件路径由 app 侧经 AIDL 传入。
        -->
        <service
            android:name="org.fcitx.fcitx5.android.data.voice.VoiceAsrService"
            android:exported="false"
            android:process=":asr" />

        <provider
            android:name=".provider.FcitxDataProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clipboard_file_paths" />
        </provider>

        <provider
            android:name=".utils.ShareFileProvider"
            android:authorities="${applicationId}.share.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_file_paths" />
        </provider>

        <!-- remove unneeded components from com.canhub.cropper -->
        <!--suppress DeprecatedClassUsageInspection -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            tools:node="remove" />

        <provider
            android:name="com.canhub.cropper.CropFileProvider"
            android:authorities="${applicationId}.cropper.fileprovider"
            tools:node="remove" />

        <!-- Every scan entry uses QrScanOptions and our QrScanCaptureActivity. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:node="remove" />

        <!-- Clipboard Room is single-process and does not enable this optional service. -->
        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            tools:node="remove" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:directBootAware="true"
            android:exported="false"
            tools:node="merge">
            <!-- do not inject splitties AppCompat -->
            <!-- WorkManager starts on demand on the update page, never on IME startup. -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <meta-data
                android:name="splitties.views.dsl.appcompat.experimental.AppCompatViewInstantiatorInjecter"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
