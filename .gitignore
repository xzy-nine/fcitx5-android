# Module :app
# Installed data
/app/src/main/assets/usr/
# Generated asset descriptor
/app/src/main/assets/descriptor.json

# Plugins
# Installed data
/plugin/*/src/main/assets/usr/
# Generated asset descriptor
/plugin/*/src/main/assets/descriptor.json

# Intellij
.idea/*
!.idea/codeStyles/
!.idea/copyright/
!.idea/dictionaries/

# below are generated by Android Studio

.DS_Store
/captures

# Android.gitignore
# Built application files
*.apk
*.aar
*.ap_
*.aab

# custom: vendored 官方 sherpa-onnx AAR（Apache-2.0，见 NOTICE.md）必须入库，
# 它是离线语音识别的引擎+官方 Kotlin/JNI 适配器，不随构建下载。
!app/libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
# 构建脚本模块的 IDE 编译输出（src/ 才是源码）
build-logic/**/bin/
codegen/**/bin/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
#*.iml

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Profiling
*.hprof

### Kotlin ###
.kotlin/

# Gradle / Kotlin build outputs in every module, including former library and plugin modules
**/build/
.cache/

# CodeBuddy
.codebuddy/
.workbuddy-ai/

# Python audit and benchmark helpers
__pycache__/

# Downloaded and verified versioned Android Rime SDK
/native/rime-sdk/
/native/.rime-sdk*

# mlkit 模型归档（本体由 fetchDigitalInkModel 构建期拉取）
/app/src/main/mlkit-assets/*.zip

# 已安装的预构建资源
/app/src/*/jniLibs
/app/src/*/res/values-prebuild
/app/src/*/res/xml-prebuild
/app/src/*/res/font
/app/src/main/res/font
/.prebuilt-*
/prebuilt
